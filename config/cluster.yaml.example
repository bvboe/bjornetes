# Kubernetes Cluster Configuration
#
# Copy this file to cluster.yaml and customize for your environment:
#   cp cluster.yaml.example cluster.yaml
#
# See SETUP.md for detailed configuration instructions.

cluster:
  name: my-k8s-cluster
  # Kubernetes version to deploy (minor version, e.g., "1.31")
  kubernetes_version: "1.35"
  # Use Chainguard private APK repository for latest package versions
  # Requires chainctl to be installed and authenticated locally
  use_private_apk: true
  # Pod network CIDR (must not overlap with your network)
  pod_cidr: "10.244.0.0/16"
  # Service CIDR (must not overlap with your network)
  service_cidr: "10.96.0.0/12"

# Proxmox connection settings
proxmox:
  # Proxmox host to SSH into (FQDN or IP address)
  host: "proxmox.example.com"
  # SSH user (must have permissions for qm/pvesh commands)
  user: "root"
  # SSH port
  port: 22
  # SSH key path (optional, defaults to ~/.ssh/id_rsa)
  ssh_key: "~/.ssh/id_rsa"
  # Proxmox storage for VM disks (e.g., local-lvm, nfs-storage)
  storage: "local-lvm"
  # Network bridge for VMs
  bridge: "vmbr0"

# VM defaults (can be overridden per-node)
vm_defaults:
  cores: 2
  memory: 4096 # MB
  disk_size: 32 # GB
  # Start VM ID range (ensure this doesn't conflict with existing VMs)
  vmid_start: 200
  # SSH public key for VM access
  ssh_key_file: "~/.ssh/id_rsa.pub"

# Network configuration
network:
  # Default gateway for VMs
  gateway: "192.168.1.1"
  # DNS nameserver
  nameserver: "8.8.8.8"
  # CIDR suffix for all IPs
  cidr: "/24"

# Node definitions
nodes:
  control_plane:
    # Number of control plane nodes (should be odd: 1, 3, 5)
    count: 1
    # Naming pattern ({index} replaced with 0, 1, 2...)
    name_pattern: "k8s-cp-{index}"
    # Static IP assignment (first control plane node)
    # Additional nodes get sequential IPs (cp-0=.100, cp-1=.101, etc.)
    ip_start: "192.168.1.100"
    # Override VM defaults for control plane
    cores: 4
    memory: 8192
    disk_size: 50

  workers:
    # Number of worker nodes
    count: 3
    name_pattern: "k8s-worker-{index}"
    # Static IP assignment (first worker node)
    # Additional nodes get sequential IPs (worker-0=.110, worker-1=.111, etc.)
    ip_start: "192.168.1.110"
    # Workers can use defaults or override
    cores: 4
    memory: 8192
    disk_size: 50

# NFS storage configuration (optional)
# Used for persistent volumes via nfs-subdir-external-provisioner
storage:
  nfs:
    # NFS server IP or hostname
    server: 192.168.1.10
    # NFS export path
    path: /exports/k8s-volumes
